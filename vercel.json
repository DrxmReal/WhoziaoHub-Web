{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/auth/verify",
      "destination": "/api/auth"
    },
    {
      "source": "/api/v1/search",
      "destination": "/api/search"
    },
    {
      "source": "/api/v1/manifest/(.*)",
      "destination": "/api/manifest?appId=$1"
    },
    {
      "source": "/api/files/(.*)/lua",
      "destination": "/api/file?appId=$1&type=lua"
    },
    {
      "source": "/api/files/(.*)/key",
      "destination": "/api/file?appId=$1&type=key"
    },
    {
      "source": "/api/files/(.*)/manifest/(.*)",
      "destination": "/api/file?appId=$1&type=manifest&file=$2"
    },
    {
      "source": "/api/files/(.*)/zip",
      "destination": "/api/zip?appId=$1"
    }
  ]
}
